{
  "name": "@rukaachan/pi-advisor",
  "version": "0.1.0",
  "description": "Fast focused-query advisor for Pi. The executor asks a single question with minimal context; no history dump.",
  "private": true,
  "license": "MIT",
  "author": "rukaachan",
  "repository": {
    "type": "git",
    "url": "https://github.com/rukaachan/pi-advisor"
  },
  "homepage": "https://github.com/rukaachan/pi-advisor#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/advisor.test.ts tests/advisor-state.integration.test.ts tests/advisor-ui.test.ts tests/advisor-tool.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings extensions src tests",
    "lint:fix": "oxlint --fix --deny-warnings extensions src tests",
    "format": "oxfmt --write extensions src tests",
    "format:check": "oxfmt --check extensions src tests",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "clean": "rm -rf node_modules"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "22.19.19",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
